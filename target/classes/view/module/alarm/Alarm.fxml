<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="my.id.roytamba.nextmes.module.alarm.controller.AlarmController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                
                <!-- Header -->
                <VBox spacing="5.0">
                    <Label text="Alarm &amp; Reminders" textFill="#1e293b">
                        <font>
                            <Font name="Segoe UI Bold" size="24.0" />
                        </font>
                    </Label>
                    <Label text="Monitor koneksi perangkat atau atur pengingat jadwal tugas Anda." textFill="#64748b">
                        <font>
                            <Font name="Segoe UI" size="14.0" />
                        </font>
                    </Label>
                </VBox>

                <!-- Tabs -->
                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <tabs>
                        
                        <!-- TAB 1: DEVICE MONITORING -->
                        <Tab text="Device Monitoring">
                            <content>
                                <VBox spacing="15.0" style="-fx-padding: 20 0 0 0;">
                                    <children>
                                        <!-- Toolbar -->
                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <Button fx:id="btnStart" onAction="#handleStartMonitoring" prefHeight="35.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 5;" text="Start Monitoring" />
                                            <Button fx:id="btnStop" onAction="#handleStopMonitoring" prefHeight="35.0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 5;" text="Stop Monitoring" />
                                            <Button onAction="#handleReload" prefHeight="35.0" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 5;" text="Reload Devices" />
                                            
                                            <HBox HBox.hgrow="ALWAYS" />
                                            
                                            <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="250.0" promptText="Cari Device / IP..." style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5; -fx-background-radius: 5;">
                                                <font>
                                                    <Font name="Segoe UI" size="14.0" />
                                                </font>
                                            </TextField>
                                        </HBox>

                                        <!-- Status Panel -->
                                        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                                            <Label text="Status:" textFill="#64748b">
                                                <font><Font name="Segoe UI Bold" size="14.0" /></font>
                                            </Label>
                                            <Label fx:id="lblServiceStatus" text="Service Stopped" textFill="#ef4444">
                                                <font><Font name="Segoe UI Bold" size="14.0" /></font>
                                            </Label>
                                            <Label text=" | Total Devices:" textFill="#64748b">
                                                <font><Font name="Segoe UI Bold" size="14.0" /></font>
                                            </Label>
                                            <Label fx:id="lblTotalDevices" text="0" textFill="#1e293b">
                                                <font><Font name="Segoe UI Bold" size="14.0" /></font>
                                            </Label>
                                            <Label text=" | Offline:" textFill="#64748b">
                                                <font><Font name="Segoe UI Bold" size="14.0" /></font>
                                            </Label>
                                            <Label fx:id="lblTotalOffline" text="0" textFill="#ef4444">
                                                <font><Font name="Segoe UI Bold" size="14.0" /></font>
                                            </Label>
                                        </HBox>

                                        <!-- Table -->
                                        <TableView fx:id="tableDevice" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                                            <columns>
                                                <TableColumn fx:id="colType" prefWidth="120.0" text="Tipe Device" />
                                                <TableColumn fx:id="colName" prefWidth="250.0" text="Nama Device" />
                                                <TableColumn fx:id="colIp" prefWidth="200.0" text="IP Address" />
                                                <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                                                <TableColumn fx:id="colMonitor" prefWidth="150.0" text="Monitor?" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>

                        <!-- TAB 2: TASK REMINDERS -->
                        <Tab text="Task Reminders">
                            <content>
                                <VBox spacing="15.0" style="-fx-padding: 20 0 0 0;">
                                    <children>
                                        <!-- Add Reminder Form -->
                                        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                                <Label text="Tugas / Pesan Pengingat" textFill="#64748b"><font><Font name="Segoe UI Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtReminderTitle" promptText="Misal: Inspeksi Shop Floor" prefHeight="35.0" />
                                            </VBox>
                                            <VBox spacing="5.0">
                                                <Label text="Waktu (HH:mm)" textFill="#64748b"><font><Font name="Segoe UI Bold" size="12.0" /></font></Label>
                                                <TextField fx:id="txtReminderTime" promptText="08:00" prefHeight="35.0" prefWidth="100.0" />
                                            </VBox>
                                            <VBox spacing="5.0" alignment="BOTTOM_CENTER">
                                                <Button onAction="#handleAddReminder" prefHeight="35.0" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 5;" text="Tambah Pengingat" />
                                            </VBox>
                                        </HBox>

                                        <!-- Reminders Table -->
                                        <TableView fx:id="tableReminder" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                                            <columns>
                                                <TableColumn fx:id="colReminderTime" prefWidth="150.0" text="Waktu" />
                                                <TableColumn fx:id="colReminderTitle" prefWidth="400.0" text="Pesan Pengingat" />
                                                <TableColumn fx:id="colReminderActive" prefWidth="120.0" text="Status Aktif" />
                                                <TableColumn fx:id="colReminderAction" prefWidth="150.0" text="Aksi" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>

                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
