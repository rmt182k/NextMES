<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="my.id.roytamba.nextmes.module.settings.systeminfo.controller.SystemInfoController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="Informasi Sistem">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        
        <GridPane hgap="15.0" vgap="15.0" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-border-radius: 5;">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="200.0" minWidth="10.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="350.0" />
            </columnConstraints>
            <children>
                <Label text="Versi Aplikasi:" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                <Label fx:id="lblAppVersion" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Sistem Operasi:" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                <Label fx:id="lblOs" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Versi Java (JRE):" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                <Label fx:id="lblJavaVersion" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Arsitektur:" GridPane.rowIndex="3" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                <Label fx:id="lblArch" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Direktori Kerja:" GridPane.rowIndex="4" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                <Label fx:id="lblWorkingDir" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </children>
        </GridPane>
        
        <Label text="Data di atas ditarik otomatis dari environment sistem Anda." style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
    </children>
</VBox>
