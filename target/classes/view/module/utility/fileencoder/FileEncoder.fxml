<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="my.id.roytamba.nextmes.module.utility.fileencoder.controller.FileEncoderController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="File to String Encoder &amp; Decoder">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Button onAction="#handleChooseFile" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-cursor: hand;" text="Pilih File / Browse...">
                    <padding>
                        <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                    </padding>
                </Button>
                <Button onAction="#handleClear" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-cursor: hand;" text="Clear">
                    <padding>
                        <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                    </padding>
                </Button>
                <Label fx:id="lblFileInfo" text="Tidak ada file yang dipilih" textFill="#64748b" />
            </children>
        </HBox>
        
        <HBox spacing="20.0">
            <children>
                <!-- File Preview Section -->
                <VBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5; -fx-padding: 10;">
                    <children>
                        <Label text="File Preview" style="-fx-text-fill: #94a3b8;" />
                        <!-- Using StackPane to overlap image and generic document text -->
                        <javafx.scene.layout.StackPane prefHeight="150.0" prefWidth="150.0">
                            <children>
                                <Label fx:id="lblDocPreview" text="📄 Dokumen" visible="false">
                                    <font>
                                        <Font size="24.0" />
                                    </font>
                                </Label>
                                <ImageView fx:id="imgPreview" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </javafx.scene.layout.StackPane>
                    </children>
                </VBox>
                
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Format String:" />
                            <ComboBox fx:id="cmbFormat" prefWidth="150.0" />
                            <Button onAction="#handleCopyToClipboard" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-cursor: hand;" text="Copy Text">
                                <padding>
                                    <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
                                </padding>
                            </Button>
                            <Button onAction="#handleDecodeToFile" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-cursor: hand;" text="Decode Teks ke File ↓">
                                <padding>
                                    <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
                                </padding>
                            </Button>
                        </HBox>
                        <TextArea fx:id="txtOutput" editable="true" prefHeight="165.0" promptText="Pilih file untuk melihat hasil konversi teks di sini, ATAU paste string di sini untuk men-decode nya menjadi file." wrapText="true" style="-fx-control-inner-background: #f8fafc;" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
