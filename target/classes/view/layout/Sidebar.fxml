<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="sidebar" prefWidth="220.0" style="-fx-background-color: #1e293b;" 
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="my.id.roytamba.nextmes.layout.controller.SidebarController">
    <padding>
        <Insets bottom="20.0" top="20.0" />
    </padding>
    <children>
        
        <HBox alignment="CENTER_LEFT" prefHeight="40.0">
            <VBox.margin>
                <Insets bottom="30.0" />
            </VBox.margin>
            <!-- Padding kanan disamakan dengan kiri (20) agar matematika center-nya pas -->
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <Label fx:id="lblBrand" text="NextMES" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Bold" size="22.0" />
                    </font>
                </Label>
                
                <!-- Tambahkan fx:id pada spacer ini -->
                <Region fx:id="spacer" HBox.hgrow="ALWAYS" />
                
                <Button fx:id="btnToggle" textOverrun="CLIP" onAction="#toggleSidebar" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;" text="☰" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Bold" size="18.0" />
                    </font>
                </Button>
            </children>
        </HBox>
        
        <!-- Pemisahan Graphic dan Text untuk tombol navigasi -->
        <!-- 
        <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" graphicTextGap="22.0" maxWidth="Infinity" onAction="#goToDashboard" prefHeight="45.0" style="-fx-cursor: hand;" text="Dashboard">
            <padding>
                <Insets left="20.0" />
            </padding>
            <graphic>
                <Label text="📊" textFill="#cbd5e1">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </graphic>
            <font>
                <Font name="Segoe UI" size="14.0" />
            </font>
        </Button>
        -->

        <Button fx:id="btnMonitor" alignment="BASELINE_LEFT" graphicTextGap="18.0" maxWidth="Infinity" onAction="#goToMonitor" prefHeight="45.0" style="-fx-cursor: hand;" text="Monitor">
            <padding>
                <Insets left="20.0" />
            </padding>
            <graphic>
                <Label text="🖥" textFill="#cbd5e1">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </graphic>
            <font>
                <Font name="Segoe UI" size="14.0" />
            </font>
        </Button>
        
        <Button fx:id="btnSettings" alignment="BASELINE_LEFT" graphicTextGap="15.0" maxWidth="Infinity" onAction="#goToSettings" prefHeight="45.0" style="-fx-cursor: hand;" text="Pengaturan">
            <padding>
                <Insets left="20.0" />
            </padding>
            <graphic>
                <!-- Tambahkan textFill="#cbd5e1" di sini -->
                <Label text="⚙️" textFill="#cbd5e1">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </graphic>
            <font>
                <Font name="Segoe UI" size="14.0" />
            </font>
        </Button>
    </children>
</VBox>