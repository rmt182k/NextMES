<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="my.id.roytamba.nextmes.controller.SettingsController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0">
            <padding>
                <Insets left="30.0" />
            </padding>
            <Label text="Pengaturan Sistem" styleClass="text-light" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Tampilan">
                    <VBox spacing="20.0">
                        <padding>
                            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                        </padding>
                        <Label text="Konfigurasi Resolusi Aplikasi" styleClass="text-light" style="-fx-font-size: 16px;"/>
                        
                        <GridPane hgap="15.0" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="150.0" />
                                <ColumnConstraints prefWidth="250.0" />
                            </columnConstraints>
                            <Label text="Lebar Layar (Width):" styleClass="text-light" GridPane.rowIndex="0" />
                            <TextField fx:id="txtAppWidth" text="1000" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            
                            <Label text="Tinggi Layar (Height):" styleClass="text-light" GridPane.rowIndex="1" />
                            <TextField fx:id="txtAppHeight" text="650" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        </GridPane>
                        
                        <HBox spacing="10.0">
                            <Button text="Simpan Tampilan" styleClass="btn-primary" onAction="#handleSaveAppearance">
                                <padding>
                                    <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                                </padding>
                            </Button>
                        </HBox>
                    </VBox>
                </Tab>

                <Tab text="Koneksi Database">
                    <VBox spacing="20.0">
                        <padding>
                            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                        </padding>
                        <Label text="Konfigurasi Server Database" styleClass="text-light" style="-fx-font-size: 16px;"/>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>