<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="my.id.roytamba.nextmes.module.generator.grid.controller.GridGeneratorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <center>
        <SplitPane dividerPositions="0.65" orientation="VERTICAL" style="-fx-background-color: transparent;">
            
            <!-- TOP: CONFIG & COLUMNS -->
            <VBox spacing="10.0">
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="Jumlah Kolom:">
                        <font>
                            <Font name="Segoe UI Bold" size="14.0" />
                        </font>
                    </Label>
                    <Spinner fx:id="spinnerCols" prefWidth="80.0" />
                    <Button onAction="#handleCreateColumns" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-cursor: hand;" text="🏗 Buat Kolom" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleClearData" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-cursor: hand;" text="🗑 Bersihkan Isi" />
                </HBox>
                
                <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <HBox fx:id="columnsContainer" spacing="15.0" />
                </ScrollPane>
            </VBox>

            <!-- BOTTOM: OUTPUT -->
            <VBox spacing="10.0">
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="Format Output:">
                        <font>
                            <Font name="Segoe UI Bold" size="14.0" />
                        </font>
                    </Label>
                    <ComboBox fx:id="cmbFormat" prefWidth="200.0" />
                    <Button onAction="#handleGenerate" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="🚀 Generate Data" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleCopy" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-cursor: hand;" text="📋 Copy Output" />
                </HBox>
                
                <TextArea fx:id="txtOutput" editable="false" promptText="Hasil generate (JSON/Array) akan muncul di sini..." VBox.vgrow="ALWAYS">
                    <font>
                        <Font name="Consolas" size="13.0" />
                    </font>
                </TextArea>
            </VBox>
            
        </SplitPane>
    </center>
</BorderPane>
