<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="my.id.roytamba.nextmes.module.generator.controller.GeneratorController">
    
    <top>
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 20;" text="Utility Generators" BorderPane.alignment="CENTER_LEFT" />
    </top>
    
    <center>
        <TabPane style="-fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <!-- TAB WO FORMATTER -->
                <Tab text="Format Array / List">
                    <content>
                        <fx:include source="formatter/WoFormatter.fxml" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
