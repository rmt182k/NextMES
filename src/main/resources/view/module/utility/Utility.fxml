<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="my.id.roytamba.nextmes.module.utility.controller.UtilityController">
    
    <top>
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 20;" text="Utility Tools" BorderPane.alignment="CENTER_LEFT" />
    </top>
    
    <center>
        <TabPane style="-fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <!-- TAB DECODER -->
                <Tab text="Text Decoder">
                    <content>
                        <fx:include source="converter/Converter.fxml" />
                    </content>
                </Tab>

                <!-- TAB ENCODER -->
                <Tab text="File Encoder">
                    <content>
                        <fx:include source="fileencoder/FileEncoder.fxml" />
                    </content>
                </Tab>
                
                <!-- TAB TEXT COMPARE -->
                <Tab text="Text Compare">
                    <content>
                        <fx:include source="textcompare/TextCompare.fxml" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
