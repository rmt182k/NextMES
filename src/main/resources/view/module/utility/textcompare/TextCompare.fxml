<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="my.id.roytamba.nextmes.module.utility.textcompare.controller.TextCompareController">
    <!-- Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button onAction="#handleCompare" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Compare" />
        <Button onAction="#handleClear" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Clear" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Precision:" />
        <ComboBox fx:id="cmbPrecision" prefWidth="120.0" />
        <Label text="Layout:" />
        <ComboBox fx:id="cmbLayout" prefWidth="120.0" />
    </HBox>

    <!-- SplitPane for Input vs Output -->
    <SplitPane orientation="VERTICAL" VBox.vgrow="ALWAYS">
        <!-- Input Areas -->
        <SplitPane orientation="HORIZONTAL" SplitPane.resizableWithParent="false">
            <VBox spacing="5.0">
                <Label text="Original Code / Text:" style="-fx-font-weight: bold;" />
                <TextArea fx:id="txtOriginal" VBox.vgrow="ALWAYS" promptText="Paste original text here..." style="-fx-font-family: monospace;" />
            </VBox>
            <VBox spacing="5.0">
                <Label text="Modified Code / Text:" style="-fx-font-weight: bold;" />
                <TextArea fx:id="txtModified" VBox.vgrow="ALWAYS" promptText="Paste modified text here..." style="-fx-font-family: monospace;" />
            </VBox>
        </SplitPane>

        <!-- Result WebView -->
        <VBox spacing="5.0">
            <Label text="Comparison Result:" style="-fx-font-weight: bold;" />
            <WebView fx:id="webViewResult" VBox.vgrow="ALWAYS" />
        </VBox>
    </SplitPane>
</VBox>
