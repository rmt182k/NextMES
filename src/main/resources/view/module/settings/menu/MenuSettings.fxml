<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="my.id.roytamba.nextmes.module.settings.menu.controller.MenuSettingsController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="Konfigurasi Manajemen Menu">
            <font>
                <Font name="Segoe UI Bold" size="16.0" />
            </font>
        </Label>
        
        <GridPane hgap="15.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="350.0" minWidth="10.0" prefWidth="250.0" />
            </columnConstraints>
            <children>
                <Label text="Menu Default (Startup):" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbDefaultMenu" prefWidth="350.0" promptText="Pilih Menu Default" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            </children>
        </GridPane>
        
        <HBox spacing="10.0">
            <children>
                <Button onAction="#handleSaveMenuSettings" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-cursor: hand;" text="Simpan Pengaturan Menu">
                    <padding>
                        <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
