<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="my.id.roytamba.nextmes.module.settings.plc.controller.PlcMasterController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    
    <!-- Bagian Form (Kiri) -->
    <VBox prefWidth="300.0" spacing="15.0">
        <children>
            <Label text="Tambah Mesin PLC Baru">
                <font>
                    <Font name="Segoe UI Bold" size="16.0" />
                </font>
            </Label>
            
            <VBox spacing="5.0">
                <Label text="Kategori (Group):" />
                <ComboBox fx:id="cmbCategory" prefWidth="300.0" promptText="Pilih Kategori..." />
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="Nama Mesin:" />
                <TextField fx:id="txtName" promptText="Cth: PLC Robot Painting" />
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="IP Address:" />
                <TextField fx:id="txtIp" promptText="Cth: 192.168.0.100" />
            </VBox>
            
            <Button maxWidth="Infinity" onAction="#handleSave" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-cursor: hand;" text="Simpan ke Master">
                <padding>
                    <Insets bottom="10.0" top="10.0" />
                </padding>
            </Button>
            
            <VBox spacing="5.0" style="-fx-border-color: #ddd; -fx-border-width: 1; -fx-padding: 10; -fx-border-radius: 5;">
                <Label text="Pengaturan Global PLC:" style="-fx-font-weight: bold;" />
                <Label text="Interval Ping (Detik):" />
                <HBox spacing="10.0">
                    <TextField fx:id="txtInterval" prefWidth="80.0" />
                    <Button onAction="#handleUpdateInterval" text="Update Interval" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-cursor: hand;" />
                </HBox>
            </VBox>
        </children>
    </VBox>

    <!-- Bagian Tabel (Kanan) -->
    <VBox HBox.hgrow="ALWAYS" spacing="10.0">
        <children>
            <HBox alignment="CENTER_LEFT">
                <Label text="Daftar Mesin PLC (Tersimpan)">
                    <font>
                        <Font name="Segoe UI Bold" size="16.0" />
                    </font>
                </Label>
                <HBox HBox.hgrow="ALWAYS" />
                <Label text="Cari:">
                    <font>
                        <Font name="Segoe UI" size="14.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="10.0" />
                    </HBox.margin>
                </Label>
                <TextField fx:id="txtSearch" prefWidth="200.0" promptText="Nama atau IP..." />
                
                <Button onAction="#handleDelete" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-cursor: hand;" text="Hapus yang Dipilih">
                    <padding>
                        <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
                    </padding>
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </Button>
            </HBox>
            
            <TableView fx:id="tablePlc" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                    <TableColumn fx:id="colCategory" prefWidth="120.0" text="Kategori (Group)" />
                    <TableColumn fx:id="colName" prefWidth="180.0" text="Nama Mesin" />
                    <TableColumn fx:id="colIp" prefWidth="130.0" text="IP Address" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </children>
    </VBox>
</HBox>
