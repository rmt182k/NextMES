<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="my.id.roytamba.nextmes.module.monitor.controller.MonitorController">
    
    <top>
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 20;" text="Sistem Monitoring" BorderPane.alignment="CENTER_LEFT" />
    </top>
    
    <center>
        <TabPane style="-fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <!-- TAB PLC -->
                <Tab text="PLC">
                    <content>
                        <fx:include source="plc/PlcMonitor.fxml" />
                    </content>
                </Tab>
                
                <!-- TAB MES PC -->
                <Tab text="MES PC">
                    <content>
                        <fx:include source="pc/PcMonitor.fxml" />
                    </content>
                </Tab>
                
                <!-- TAB PRINTER -->
                <Tab text="Printer">
                    <content>
                        <fx:include source="printer/PrinterMonitor.fxml" />
                    </content>
                </Tab>
                
                <!-- TAB DC TOOL -->
                <Tab text="DC Tool">
                    <content>
                        <fx:include source="dctool/DcToolMonitor.fxml" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
