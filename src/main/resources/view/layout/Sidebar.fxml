<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="my.id.roytamba.nextmes.layout.controller.SidebarController"
      spacing="5.0" style="-fx-padding: 20 0 0 0;">
    
    <Button fx:id="btnDashboard" text="📊   Dashboard" maxWidth="Infinity" styleClass="sidebar-btn" onAction="#goToDashboard"/>
    <Button fx:id="btnProduction" text="🏭   Modul Produksi" maxWidth="Infinity" styleClass="sidebar-btn" />
    <Button fx:id="btnSettings" text="⚙️   Pengaturan" maxWidth="Infinity" styleClass="sidebar-btn" onAction="#goToSettings"/>
    
</VBox>